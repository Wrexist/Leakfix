# Local data directory for the embedded Postgres (PGlite).
# Use "memory" for an ephemeral in-process database (tests / CI).
DATABASE_DIR=./data/pglite

# Test-only escape hatch. When "true", scans may target loopback and private
# addresses. NEVER enable this in production.
LEAKFIX_ALLOW_PRIVATE_TARGETS=false

# Public base URL of the site. Used for canonical/OG metadata, robots.txt and
# the sitemap. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://leakfix.example

# Shared secret for the scheduled monitoring endpoint.
# POST/GET /api/cron/rescan with "Authorization: Bearer <CRON_SECRET>".
# Leave empty to disable the endpoint (it returns 503). See docs/monitoring.md.
CRON_SECRET=
