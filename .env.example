# PostgreSQL connection string. REQUIRED in production (Neon, Supabase, RDS, ...).
# When set, it takes precedence over DATABASE_DIR. Use the pooled URL on
# serverless hosts. The schema is created/migrated automatically on first use.
# DATABASE_URL=postgres://user:password@host:5432/leakfix?sslmode=require

# Local data directory for the embedded Postgres (PGlite).
# Use "memory" for an ephemeral in-process database (tests / CI).
DATABASE_DIR=./data/pglite

# Test-only escape hatch. When "true", scans may target loopback and private
# addresses. NEVER enable this in production.
LEAKFIX_ALLOW_PRIVATE_TARGETS=false

# Public base URL of the site. Used for canonical/OG metadata, robots.txt and
# the sitemap. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://leakfix.example

# Optional public contact address. Shows a Contact link in the footer and a
# "Tell me when it launches" button on the pricing page's agency card.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Shared secret for the scheduled monitoring endpoint.
# POST/GET /api/cron/rescan with "Authorization: Bearer <CRON_SECRET>".
# Leave empty to disable the endpoint (it returns 503). See docs/monitoring.md.
CRON_SECRET=

# Email notifications (optional). Resend is the default provider. Leave the key
# empty to disable email; webhook notifications still work.
# EMAIL_API_KEY=re_xxxxxxxx
# EMAIL_FROM=LeakFix <alerts@yourdomain.com>
# EMAIL_API_URL=https://api.resend.com/emails

# Pricing shown on the paywall and used for Stripe Checkout.
LEAKFIX_PRICE_CENTS=1900
LEAKFIX_PRICE_CURRENCY=usd

# Payments (optional). Set the secret key AND the webhook secret to enable real
# Stripe Checkout; without both, the paywall says checkout opens soon.
# Subscribe the webhook (/api/stripe/webhook) to checkout.session.completed and
# checkout.session.async_payment_succeeded.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: a Stripe Price id. Without it, Checkout charges LEAKFIX_PRICE_CENTS.
# If set, keep it equal to LEAKFIX_PRICE_CENTS.
# STRIPE_PRICE_ID=price_xxx

# Development/test unlock. Grants report unlocks without payment. Ignored when
# NODE_ENV=production (unless LEAKFIX_DEV_UNLOCK_ALLOW_PRODUCTION=true, which only
# the E2E suite sets). Never enable either in a real deployment.
LEAKFIX_DEV_UNLOCK=false

# Cookie-free funnel analytics via Plausible (optional). Set to your site's
# domain as registered in Plausible, e.g. leakfix.com.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Postal address printed in follow-up emails to "Email me this report" leads.
# Commercial email must include one (CAN-SPAM); follow-ups aren't sent without it.
# Run GET/POST /api/cron/follow-ups daily with the CRON_SECRET to send them.
# LEAKFIX_POSTAL_ADDRESS=LeakFix, 123 Example St, City, Country

# Accounts and Pro (optional). Sign-in links are emailed, so accounts need the
# EMAIL_API_KEY/EMAIL_FROM settings above. Pro is offered whenever Stripe is
# configured. Also subscribe the Stripe webhook to customer.subscription.created,
# customer.subscription.updated and customer.subscription.deleted, and enable
# the customer portal in the Stripe dashboard for "Manage billing".
# LEAKFIX_PRO_PRICE_CENTS=2900
# LEAKFIX_PRO_INTERVAL=month
# Optional: a recurring Stripe Price for Pro. Without it, Checkout charges
# LEAKFIX_PRO_PRICE_CENTS per interval.
# STRIPE_PRO_PRICE_ID=price_xxx
# Monitors a Pro subscriber can add for sites they haven't bought a report for.
# LEAKFIX_PRO_MONITOR_LIMIT=10
